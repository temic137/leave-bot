APP_NAME=Slack Leave Bot
DATABASE_URL=sqlite:///./leavebot.db
# Railway Postgres production value:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
LEAVE_POLICY_PATH=config/leave_policy.json
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# disabled: use local prototype data
# shadow: allow explicit sync/diagnostics without changing bot decisions
# live: use Performance API for eligibility, balances, and request mirroring
PERFORMANCE_API_URL=https://performance.autochek.africa
PERFORMANCE_API_TOKEN=
PERFORMANCE_API_MODE=disabled
PERFORMANCE_API_TIMEOUT_SECONDS=10

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
AGENTSPAN_SERVER_URL=http://localhost:6767

JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_SECONDS=0.5
JOB_LOCK_TIMEOUT_SECONDS=300
JOB_MAX_ATTEMPTS=8
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
